{
  "manifest_version": 3,
  "name": "Tab Volume Booster",
  "version": "2.0.1",
  "description": "Adjust the volume of compatible web audio and video players from 0% to 600% per tab.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-volume-booster@kianbahasadri.github.io",
      "strict_min_version": "142.0",
      "update_url": "https://github.com/KianBahasadri/tab-volume-booster/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tab Volume Booster",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Open volume controls"
    }
  }
}
